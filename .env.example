# Image tag published by CI, or "dev" for local builds
IMAGE_TAG=dev

# Host port mapping (container stays on 42420)
VS_PORT=42420

# Server bind overrides (passed as startup parameters)
VS_MAX_CLIENTS=16

# Extra Vintage Story startup args (space-separated)
# See https://wiki.vintagestory.at/Server_startup_parameters/en
VS_EXTRA_ARGS=

# Backups
VS_BACKUP_ENABLED=true
VS_BACKUP_INTERVAL_SEC=3600
VS_BACKUP_RETENTION=24
VS_BACKUP_ON_SHUTDOWN=true

# Compose resource limits (wiki: ~1 GB base + ~300 MB per player)
VS_CPUS=2.0
VS_MEM_LIMIT=2g
VS_MEM_RESERVATION=1g
VS_PIDS_LIMIT=256
